{
  "name": "pstack-vibe",
  "version": "0.15.42-vibe.1",
  "type": "module",
  "description": "pstack for the Mistral Vibe CLI",
  "license": "MIT",
  "bin": {
    "pstack-vibe": "bin/pstack-vibe.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/mock-drive.mjs",
    "scripts/mock-provider.mjs",
    "generated/vibe/",
    "model-sheet/",
    "LICENSE",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "vibe": {
    "tested": [
      "3.1.2"
    ]
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check": "node scripts/generate.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "test:shell": "sh tests/session-start.test.sh && sh tests/chain-record.test.sh && sh tests/chain-gate.test.sh",
    "lint": "shellcheck generated/vibe/ai.mistral.vibe/scripts/*.sh && npx --yes markdownlint-cli2 \"README.md\" \"NOTICE.md\" \"SECURITY.md\" \"CHANGELOG.md\" \"docs/**/*.md\" && npx --yes github-actionlint",
    "verify": "npm test && npm run test:shell && npm run check && npm run lint"
  },
  "devDependencies": {
    "smol-toml": "^1.9.1"
  }
}
